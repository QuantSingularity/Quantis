# Stage 1: Builder
FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
# (build context is the repository root, see infrastructure/docker-compose.yml)
COPY code/backend/requirements.txt .
RUN pip install --upgrade pip \
    && pip install --no-cache-dir --prefix=/install -r requirements.txt

# Stage 2: Runtime
FROM python:3.11-slim AS runtime

# Create non-root user
RUN groupadd -r quantis && useradd -r -g quantis -d /app -s /sbin/nologin quantis

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application source. The backend uses package-relative imports, so it is
# served as `backend.core.app:app` with /app on the import path.
COPY --chown=quantis:quantis code/backend ./backend
COPY --chown=quantis:quantis code/quant_ml ./quant_ml

# Create directories for models and logs, and let the app user write to /app
# (the default SQLite database is created in the working directory)
RUN mkdir -p /app/models /app/logs \
    && chown -R quantis:quantis /app

ENV PYTHONPATH=/app

# Switch to non-root user
USER quantis

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run with gunicorn for production
CMD ["gunicorn", "backend.core.app:app", \
     "--workers", "4", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "120", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
